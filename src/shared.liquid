{% assign fields = trmnl.plugin_settings.custom_fields_values %}
{% assign language = fields.language | default: 'en' | downcase | strip %}
{% assign show_note = fields.show_explanation | default: 'no' | downcase | strip %}
{% assign artwork_title = 'The Returning Arcade' %}
{% assign artwork_note = 'An architectural study in perspective and depth.' %}
{% if language == 'de' %}
  {% assign artwork_title = 'Die wiederkehrende Arkade' %}
  {% assign artwork_note = 'Eine architektonische Studie über Perspektive und Tiefe.' %}
{% endif %}
{% assign artwork_url = 'https://raw.githubusercontent.com/michaelkurath/Impossible-Geometry/art/returning-arcade/assets/artwork/returning-arcade.png' %}
{% capture gallery_art %}
<div class="ig-art"><img class="image image-dither" src="{{ artwork_url }}" alt="{{ artwork_title | escape }}" /></div>
{% endcapture %}
{% capture gallery_footer %}
<div class="title_bar"><span class="title">Impossible Geometry</span><span class="instance">{{ artwork_title | escape }}</span></div>
{% endcapture %}
{% capture gallery_footer_compact %}
<div class="title_bar"><span class="title">{{ artwork_title | escape }}</span><span class="instance">01</span></div>
{% endcapture %}
<style>
/* Flexible image box preserves the full composition in every mashup size. */
.ig-art { flex: 1 1 0; min-height: 0; min-width: 0; width: 100%; display: flex; align-items: center; justify-content: center; }
.ig-art > img { display: block; width: 100%; height: 100%; object-fit: contain; }
</style>
